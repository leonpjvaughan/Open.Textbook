    },
    {
     "id": "trig-ratios",
     "name": "Trigonometric ratios",
     "latex": "\\sin A = \\frac{a}{c} \\qquad \\cos A = \\frac{b}{c} \\qquad \\tan A = \\frac{a}{b}",
