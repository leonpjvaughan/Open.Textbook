{
  "name": "open-textbook",
  "private": true,
  "type": "module",
  "description": "The browser runtime and the build-time tooling for the Open.Textbook collection",
  "dependencies": {
    "katex": "0.19.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "modern-web-guidance": "1.0.1",
    "pagefind": "1.6.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "wrangler": "4.165.0"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "types": "node tools/dist/cli.js types",
    "types:list": "node tools/dist/cli.js types --list",
    "kit": "node tools/dist/cli.js kit-pure",
    "kit:browser": "node tools/dist/cli.js kit site",
    "audit": "node tools/dist/cli.js audit site",
    "audit:mobile": "node tools/dist/cli.js audit site --mobile",
    "check": "scripts/check.sh",
    "mobile": "node tools/dist/cli.js check-mobile site",
    "preview": "scripts/preview-themes.sh",
    "guidance": "modern-web-guidance",
    "guidance:legacy": "modern-web-guidance legacy-scan ."
  }
}
