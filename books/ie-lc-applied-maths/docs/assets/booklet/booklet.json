{
 "meta": {
  "title": "Leaving Certificate Physics — formulae and tables",
  "year": "state examinations",
  "note": "The State Examinations Commission publishes one booklet for the state examinations, and it is the same for Foundation, Ordinary and Higher level. The superintendent issues it at the start of the examination and collects it at the end; a candidate may not bring their own copy. Everything printed here is therefore given to you, which is why every item is in the `given` group.",
  "provenance": {
   "sec": "Foirmlí agus Táblaí / Formulae and Tables, approved for use in the state examinations. Coimisiún na Scrúduithe Stáit / State Examinations Commission, SEC567/14-V5-Dec2014, ISBN 978 1 4064 2862 9."
  },
  "basis": "The booklet is published by the Stationery Office for the State Examinations Commission and is issued to every candidate. The physics sections reproduced here are pages 47 to 63 of the booklet — the constants table, particle physics, mechanics, collisions, motion in a circle, centres of gravity, moments of inertia, rotating bodies, simple harmonic motion, energy and work, gravitation, forces and materials, heat and temperature, light and sound, geometric optics, electricity and radioactivity. The mathematics sections are pages 8 to 44 and are carried by the Mathematics book.",
  "boards": {
   "sec": {
    "name": "SEC",
    "code": "State Examinations Commission"
   }
  },
  "groups": {
   "given": "Printed in the booklet issued to every candidate."
  }
 },
