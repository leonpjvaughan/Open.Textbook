# Cloudflare deploy credentials, for local deploys only.
#
# Copy to .env and fill in. .env is git-ignored; this file is not.
#
# In CI the same values come from repository secrets, named CLOUDFLARE_API_TOKEN
# and CLOUDFLARE_ACCOUNT_ID.
#
# Wrangler reads CLOUDFLARE_* by default; scripts/deploy.sh maps these shorter
# names onto them. See SHAPE.md, "Deployment and platform targets".
CF_ACCOUNT_ID=
CF_API_TOKEN=
