{
  // Emit config for the figure kit: `assets/figures/src/**` -> `assets/figures/**`.
  // One output file per input, not a bundle, so a stack trace names `kit/draw.js`.
  // Comments are stripped after emit by `tools/build.mjs`, except the JSDoc blocks
  // that carry types; this config emits them so that pass can choose.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "ES2023.Array", "DOM", "DOM.Iterable"],
    "rootDir": "assets/figures/src",
    "outDir": "assets/figures",
    "removeComments": false,
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "types": [],
    "strict": false,
    // Transpile, do not check: `tsconfig.json` and `node tools/dist/cli.js types` ratchet
    // types separately, and a build that cannot run until every line is annotated is a
    // build nobody runs.
    "noCheck": true
  },
  // `exclude` is stated explicitly so tsc does not auto-exclude `outDir`. The output
  // tree contains the source tree here, which is the one case that trips it.
  "exclude": ["node_modules"],
  "include": ["assets/figures/src/**/*.ts"]
}
